# Copy to .env for local overrides; .env is not committed.
# Variables already set in the environment win over the file.
# Every variable is optional, the values below are the defaults.

# Address to listen on. Behind a reverse proxy, 127.0.0.1 accepts local
# connections only. IPv6 addresses work too, e.g. ::1.
#HOST=0.0.0.0

# Port to listen on.
#PORT=3000

# Public address of the site, for absolute links in the page head, the feed,
# the sitemap and robots.txt.
#SITE_URL=https://www.taichiwayfarer.com

# Ask search engines not to index the site, e.g. for a test copy: sends
# X-Robots-Tag: noindex and a robots.txt that disallows everything.
# On when set, even empty, unless "0" or "false".
#NOINDEX=0

# Directory with the posts' markdown files.
#POST_DIR=posts

# Directory with styles.css, fonts, images and favicon.ico.
#STATIC_DIR=dist

# Development mode: live reload, no caching, and scheduled posts shown as
# published. On when set, even empty, unless "0" or "false". `just watch` sets it.
#DEV=

# Log filter, see tracing-subscriber's EnvFilter.
#RUST_LOG=taichiwayfarer=debug,tower_http=info
